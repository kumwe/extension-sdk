{
  "name": "kumwe/extension-sdk",
  "description": "Canonical Kumwe extension contracts, manifest parsing, author SPI and neutral package inspection tooling.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kumwe/extension-sdk",
  "support": {
    "issues": "https://github.com/kumwe/extension-sdk/issues",
    "source": "https://github.com/kumwe/extension-sdk"
  },
  "require": {
    "php": "^8.5",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-sodium": "*",
    "ext-zip": "*",
    "doctrine/dbal": "^4.3",
    "kumwe/conversion": "^0.1",
    "kumwe/producer": "^0.2",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/http-server-handler": "^1.0",
    "ramsey/uuid": "^4.7"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0"
  },
  "bin": [
    "bin/kumwe-extension"
  ],
  "autoload": {
    "psr-4": {
      "Kumwe\\Extension\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kumwe\\Extension\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "validate-package": "@composer validate --strict --no-check-publish",
    "autoload": "@composer dump-autoload --optimize --strict-psr --no-interaction",
    "lint": "php tools/lint.php",
    "docs": "php tools/check-docblocks.php",
    "contract": "php tools/verify-contract.php",
    "test": "php tests/run.php",
    "analyse": "phpstan analyse --configuration=phpstan.neon --no-progress",
    "audit-dependencies": "@composer audit --no-interaction",
    "smoke": "php tools/autoload-smoke.php",
    "check": [
      "@validate-package",
      "@autoload",
      "@lint",
      "@docs",
      "@contract",
      "@test",
      "@analyse",
      "@audit-dependencies"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
