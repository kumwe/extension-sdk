{
  "name": "kumwe/extension-sdk",
  "description": "Canonical Kumwe extension contracts, manifest parsing, author SPI and neutral package inspection tooling.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kumwe/extension-sdk",
  "support": {
    "issues": "https://github.com/kumwe/extension-sdk/issues",
    "source": "https://github.com/kumwe/extension-sdk"
  },
  "require": {
    "doctrine/dbal": "^4.3",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-sodium": "*",
    "ext-zip": "*",
    "kumwe/access-control": "0.1.0",
    "kumwe/administrator-contract": "0.1.0",
    "kumwe/automation": "0.1.0",
    "kumwe/business-policy": "0.1.0",
    "kumwe/business-surface-contract": "0.1.0",
    "kumwe/canonical-json": "0.1.1",
    "kumwe/contribution": "0.1.0",
    "kumwe/conversion": "0.1.0",
    "kumwe/idempotency": "0.1.0",
    "kumwe/integration": "0.1.0",
    "kumwe/portal-contract": "0.1.0",
    "kumwe/producer": "0.2.1",
    "kumwe/record-model": "0.1.0",
    "kumwe/record-query": "0.1.0",
    "kumwe/record-values": "0.1.0",
    "kumwe/reporting": "0.1.0",
    "php": "^8.5",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/http-server-handler": "^1.0",
    "ramsey/uuid": "^4.7"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0",
    "kumwe/computation": "0.2.1"
  },
  "bin": [
    "bin/kumwe-extension"
  ],
  "autoload": {
    "psr-4": {
      "Kumwe\\Extension\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kumwe\\Extension\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "validate-package": "@composer validate --strict --no-check-publish",
    "autoload": "@composer dump-autoload --optimize --strict-psr --no-interaction",
    "lint": "php tools/lint.php",
    "docs": "php tools/check-docblocks.php",
    "contract": "php tools/verify-contract.php",
    "test": "php tests/run.php",
    "analyse": "phpstan analyse --configuration=phpstan.neon --no-progress",
    "audit-dependencies": "@composer audit --no-interaction",
    "smoke": "php tools/autoload-smoke.php",
    "check": [
      "@validate-package",
      "@test:dependency-selection",
      "@autoload",
      "@lint",
      "@docs",
      "@contract",
      "@api",
      "@manifests",
      "@test:package-set",
      "@test:ownership",
      "@test:source-install",
      "@test",
      "@analyse",
      "@audit-dependencies",
      "@release-record",
      "@release:integrity"
    ],
    "test:ownership": "php tools/verify-test-ownership.php --self-test",
    "release-record": "bash tools/test-release-record.sh",
    "release:integrity": "bash tools/test-release-integrity.sh",
    "test:source-install": "bash tools/test-source-candidate.sh",
    "test:dependency-selection": "bash tools/test-dependency-selection.sh",
    "api": "php tools/public-api.php",
    "manifests": "php tools/verify-v2-metadata.php",
    "test:package-set": "php tools/test-package-set-consumer.php"
  },
  "config": {
    "sort-packages": true
  },
  "suggest": {
    "kumwe/computation": "Required by the native CLI composition root; install the documented candidate with ext-kumwe_engine and an exact compatibility tuple."
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/access-control.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/administrator-contract.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/automation.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/business-definition.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/business-policy.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/business-surface-contract.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/canonical-json.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/computation.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/idempotency.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/integration.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/portal-contract.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/record-model.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/record-query.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/record-values.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/reporting.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/sequence.git"
    }
  ]
}
