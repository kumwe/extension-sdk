#!/usr/bin/env php
<?php

/**
 * Host-independent command line entry point for the Kumwe extension SDK.
 *
 * Every lane composes the same production objects the PHP API exposes: one `PackageInspector` over the
 * shipped `PackageLimits`, the `DeterministicPackageBuilder` for `build`, the `PackageEvidenceInspector`
 * for `evidence`, and the `StaticConformanceRunner` for `conformance`.
 *
 * @since 0.2.0
 */

declare(strict_types=1);

use Kumwe\CanonicalJson\CanonicalEncoder;
use Kumwe\Computation\CapabilitySet;
use Kumwe\Computation\NativeCanonicalEncoder;
use Kumwe\Computation\NativeCompatibility;
use Kumwe\Engine\Runtime;
use Kumwe\Extension\Package\PackageCodeConformance;
use Kumwe\Extension\Package\PackageEvidenceInspector;
use Kumwe\Extension\Package\PackageEvidenceScope;
use Kumwe\Extension\Package\PackageLimits;
use Kumwe\Extension\Package\ZipArchiveContentReader;
use Kumwe\Extension\Toolchain\DeterministicPackageBuilder;
use Kumwe\Extension\Toolchain\PackageInspector;
use Kumwe\Extension\Toolchain\StaticConformanceRunner;

$root = dirname(__DIR__);
$composerAutoload = $GLOBALS['_composer_autoload_path'] ?? $root . '/vendor/autoload.php';
if (is_string($composerAutoload) && is_file($composerAutoload)) {
    require $composerAutoload;
} else {
    spl_autoload_register(static function (string $class) use ($root): void {
        $prefix = 'Kumwe\\Extension\\';
        if (!str_starts_with($class, $prefix)) {
            return;
        }
        $path = $root . '/src/' . str_replace('\\', '/', substr($class, strlen($prefix))) . '.php';
        if (is_file($path)) {
            require $path;
        }
    });
}

$arguments = array_slice($argv, 1);
$command = array_shift($arguments);
if (!is_string($command) || in_array($command, ['help', '--help', '-h'], true)) {
    fwrite(STDOUT, <<<'HELP'
Kumwe extension SDK

Usage:
  kumwe-extension build ABSOLUTE_SOURCE --output=ABSOLUTE_ARCHIVE
  kumwe-extension inspect ABSOLUTE_ARCHIVE
  kumwe-extension evidence ABSOLUTE_ARCHIVE
  kumwe-extension conformance ABSOLUTE_ARCHIVE

The commands report facts only. Installation and activation policy belongs to the consuming host.
HELP . "\n");
    exit($command === null ? 2 : 0);
}

$target = array_shift($arguments);
if (!is_string($target) || $target === '' || !str_starts_with($target, '/')) {
    fwrite(STDERR, "The command target must be a canonical absolute path.\n");
    exit(2);
}

try {
    $canonicalEncoder = nativeCanonicalEncoder();
    $archiveInspector = new PackageInspector($canonicalEncoder, new PackageLimits());
    $result = match ($command) {
        'build' => buildPackage($canonicalEncoder, $target, $arguments, $archiveInspector),
        'inspect' => $archiveInspector->inspect($target)->toArray(),
        'evidence' => inspectEvidence($target, $archiveInspector),
        'conformance' => runConformance($target, $archiveInspector),
        default => throw new InvalidArgumentException(sprintf('Unknown command %s.', $command)),
    };
    fwrite(STDOUT, json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
    if ($command === 'conformance' && ($result['conforms'] ?? false) !== true) {
        exit(1);
    }
} catch (Throwable $failure) {
    fwrite(STDERR, $failure->getMessage() . "\n");
    exit(1);
}

/**
 * Build one deterministic package.
 *
 * @param   string            $source     Canonical absolute source directory.
 * @param   list<string>      $arguments  Remaining command arguments.
 * @param   PackageInspector  $inspector  Bounded package inspector shared with post-build verification.
 *
 * @return  array<string, mixed>  Build result.
 *
 * @since   0.2.0
 */
function buildPackage(CanonicalEncoder $canonicalEncoder, string $source, array $arguments, PackageInspector $inspector): array
{
    $output = null;
    foreach ($arguments as $argument) {
        if (str_starts_with($argument, '--output=')) {
            $output = substr($argument, strlen('--output='));
            continue;
        }
        throw new InvalidArgumentException(sprintf('Unknown build argument %s.', $argument));
    }
    if (!is_string($output) || !str_starts_with($output, '/')) {
        throw new InvalidArgumentException('Build requires --output=ABSOLUTE_ARCHIVE.');
    }

    return (new DeterministicPackageBuilder($canonicalEncoder, $inspector))->build($source, $output)->toArray();
}

/**
 * Produce neutral authoring evidence over one immutable package snapshot.
 *
 * @param   string            $archive    Canonical archive path.
 * @param   PackageInspector  $inspector  Bounded package inspector producing the snapshot.
 *
 * @return  array<string, mixed>  Evidence report.
 *
 * @since   0.2.0
 */
function inspectEvidence(string $archive, PackageInspector $inspector): array
{
    $package = $inspector->inspect($archive)->package;

    return (new PackageEvidenceInspector(new ZipArchiveContentReader(), new PackageCodeConformance()))
        ->inspect($package, PackageEvidenceScope::Authoring)
        ->toArray();
}

/**
 * Run complete static conformance.
 *
 * @param   string            $archive    Canonical archive path.
 * @param   PackageInspector  $inspector  Bounded package inspector producing the snapshot.
 *
 * @return  array<string, mixed>  Conformance report.
 *
 * @since   0.2.0
 */
function runConformance(string $archive, PackageInspector $inspector): array
{
    return (new StaticConformanceRunner($inspector))->run($archive)->toArray();
}

/**
 * Compose the native encoder against an explicitly supplied expected compatibility tuple.
 *
 * @return CanonicalEncoder Verified native adapter for this invocation.
 * @throws RuntimeException When the native dependency or expected tuple is unavailable.
 * @since 0.3.0
 */
function nativeCanonicalEncoder(): CanonicalEncoder
{
    if (!extension_loaded('kumwe_engine') || !class_exists(NativeCanonicalEncoder::class)) {
        throw new RuntimeException('The CLI requires kumwe/computation and the actual kumwe_engine extension.');
    }
    $configuration = getenv('KUMWE_NATIVE_EXPECTED_TUPLE');
    if (!is_string($configuration) || $configuration === '' || !is_file($configuration)) {
        throw new RuntimeException('Set KUMWE_NATIVE_EXPECTED_TUPLE to the expected compatibility JSON file.');
    }
    $bytes = file_get_contents($configuration);
    if (!is_string($bytes)) {
        throw new RuntimeException('The expected native compatibility tuple could not be read.');
    }
    $tuple = json_decode($bytes, true, 64, JSON_THROW_ON_ERROR);
    if (!is_array($tuple) || !is_array($tuple['capabilities'] ?? null)
        || !is_string($tuple['extension_version'] ?? null)
        || !is_string($tuple['embedded_engine_commit'] ?? null)
        || !is_string($tuple['embedded_source_sha256'] ?? null)
        || !is_string($tuple['binding_build_digest'] ?? null)) {
        throw new RuntimeException('The expected native compatibility tuple has an invalid shape.');
    }
    return new NativeCanonicalEncoder(new Runtime(), new NativeCompatibility(
        CapabilitySet::fromArray($tuple['capabilities']),
        $tuple['extension_version'],
        $tuple['embedded_engine_commit'],
        $tuple['embedded_source_sha256'],
        $tuple['binding_build_digest'],
    ));
}
