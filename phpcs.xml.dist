<?xml version="1.0"?>
<ruleset name="Kumwe Extension SDK">
    <description>Kumwe Extension SDK coding standard.</description>
    <file>src</file>
    <file>tests</file>
    <file>tools</file>
    <file>resources/toolchain</file>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <rule ref="PSR12"/>
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>tests/run.php</exclude-pattern>
        <exclude-pattern>tools/*</exclude-pattern>
        <exclude-pattern>resources/toolchain/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>tests/Case/FixtureProviderExecutionTest.php</exclude-pattern>
    </rule>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="160"/>
            <property name="absoluteLineLimit" value="160"/>
        </properties>
    </rule>
</ruleset>
